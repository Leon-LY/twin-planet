<view class="ctb-wrap" style="padding-bottom: {{safeBottom}}px">
  <!-- 顶部分割线 -->
  <view class="ctb-line"></view>

  <!-- Tab 项 -->
  <view class="ctb-items">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="ctb-item {{selected === index ? 'active' : ''}}"
      data-index="{{index}}"
      data-path="{{item.pagePath}}"
      bindtap="switchTab"
    >
      <text class="ctb-icon">{{item.icon}}</text>
      <text class="ctb-text">{{item.text}}</text>
      <view wx:if="{{selected === index}}" class="ctb-dot"></view>
    </view>
  </view>
</view>
