/**
 * 双宝记 v6 设计令牌 — CSS 变量 (WXSS 兼容)
 * 方向 C · 星图日记 Stellar Journal
 * 生成自 tokens.json，用于 App.vue :root 注入
 * 所有变量均兼容微信小程序 WXSS 约束
 */

page {
  /* ---- 品牌色 ---- */
  --color-baby-a: #E07B3E;
  --color-baby-b: #D48068;

  /* ---- 品牌色阶梯 ---- */
  --color-baby-a-lt: #F4C9A8;
  --color-baby-a-md: #E07B3E;
  --color-baby-a-dk: #B85F28;
  --color-baby-a-glow: rgba(224,123,62,0.18);

  --color-baby-b-lt: #EBCCBF;
  --color-baby-b-md: #D48068;
  --color-baby-b-dk: #A85543;
  --color-baby-b-glow: rgba(212,128,104,0.18);

  /* ---- 表面色 ---- */
  --color-bg: #FDFAF3;
  --color-surface: #FFF7EC;
  --color-elevated: #FFFFFF;
  --color-sunken: #F5EFE2;

  /* ---- 文字色 ---- */
  --color-ink: #2A2017;
  --color-ink-md: #948570;
  --color-ink-lt: #C8BCA8;
  --color-on-color: #FFFFFF;

  /* ---- 语义色 ---- */
  --color-success: #5C9A6E;
  --color-warning: #C8993E;
  --color-danger: #D4706B;
  --color-info: #7B9EB5;

  /* ---- 边框色 ---- */
  --color-border: #EADFCB;
  --color-divider: #F0E8D8;
  --color-focus: #E07B3E;

  /* ---- 差异等级色 ---- */
  --color-diff-green: #5C9A6E;
  --color-diff-yellow: #C8993E;
  --color-diff-red: #D4706B;

  /* ---- 字体族 ---- */
  --font-ui: 'PingFang SC', 'HarmonyOS Sans', 'Microsoft YaHei', sans-serif;
  --font-display: 'Source Han Serif SC', 'Noto Serif SC', 'Songti SC', serif;
  --font-latin: 'Inter', 'Segoe UI', sans-serif;
  --font-latin-display: 'Lora', 'Georgia', serif;
  --font-journal: 'Lora', 'Songti SC', serif;

  /* ---- 字号 ---- */
  --font-xs: 20rpx;
  --font-sm: 24rpx;
  --font-base: 28rpx;
  --font-md: 32rpx;
  --font-lg: 36rpx;
  --font-xl: 44rpx;
  --font-xxl: 56rpx;
  --font-display: 72rpx;

  /* ---- 字重 ---- */
  --weight-regular: 400;
  --weight-medium: 500;
  --weight-semibold: 600;
  --weight-bold: 700;

  /* ---- 行高 ---- */
  --leading-tight: 1.3;
  --leading-body: 1.6;
  --leading-loose: 1.8;

  /* ---- 间距 ---- */
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-xxl: 64rpx;

  /* ---- 圆角 ---- */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --radius-full: 9999rpx;

  /* ---- 阴影 ---- */
  --shadow-sm: 0 2rpx 8rpx rgba(42,32,23,0.06);
  --shadow-md: 0 4rpx 16rpx rgba(42,32,23,0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(42,32,23,0.12);
  --shadow-emboss: inset 0 2rpx 4rpx rgba(42,32,23,0.06);
  --shadow-recess: inset 0 1rpx 0 rgba(255,255,255,0.5), inset 0 -1rpx 0 rgba(42,32,23,0.04);
  --shadow-baby-a: 0 4rpx 20rpx rgba(224,123,62,0.20);
  --shadow-baby-b: 0 4rpx 20rpx rgba(212,128,104,0.20);

  /* ---- 动效时长 ---- */
  --dur-fast: 200ms;
  --dur-normal: 400ms;
  --dur-slow: 600ms;
  --dur-breath: 3000ms;

  /* ---- 缓动函数 ---- */
  --ease-soft: cubic-bezier(0.25, 0.46, 0.45, 0.94);
  --ease-stamp: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --ease-page: cubic-bezier(0.22, 0.61, 0.36, 1);

  /* ---- 触摸目标 ---- */
  --touch-min: 88rpx;
  --touch-granny: 108rpx;
  --touch-comfort: 96rpx;

  /* ---- Z-Index 层级 ---- */
  --z-base: 0;
  --z-content: 10;
  --z-sticky: 100;
  --z-overlay: 1000;
  --z-modal: 2000;
  --z-toast: 3000;

  /* ========================================================================
   * 向后兼容别名 — 旧变量名保留，映射到新令牌
   * 保证现有代码零改动即可运行
   * ======================================================================== */
  --paper: var(--color-bg);
  --cream: var(--color-surface);
  --amber: var(--color-baby-a);
  --rose: var(--color-baby-b);
  --ink-md: var(--color-ink-md);
  --ink-lt: var(--color-ink-lt);
  --mint: var(--color-success);
  --gold: var(--color-warning);
  --dot: var(--color-border);
  --twin-danger: var(--color-danger);
}

/* ---- 暗色模式覆盖 ---- */
.theme-dark {
  --color-bg: #1A1611;
  --color-surface: #2A2419;
  --color-elevated: #3A3328;
  --color-sunken: #15120E;

  --color-ink: #F5EFE2;
  --color-ink-md: #B8AC98;
  --color-ink-lt: #7A6F5E;

  --color-border: #4A4035;
  --color-divider: #3A3328;

  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.20);
  --shadow-md: 0 4rpx 16rpx rgba(0,0,0,0.25);
  --shadow-lg: 0 8rpx 32rpx rgba(0,0,0,0.35);

  /* 兼容别名同步覆盖 */
  --paper: var(--color-bg);
  --cream: var(--color-surface);
}

/* ---- 奶奶模式（大字+大触摸+高对比） ---- */
.font-large {
  --font-xs: 28rpx;
  --font-sm: 32rpx;
  --font-base: 36rpx;
  --font-md: 40rpx;
  --font-lg: 44rpx;
  --font-xl: 52rpx;
  --font-xxl: 64rpx;
  --font-display: 80rpx;

  --touch-min: 108rpx;
  --space-md: 32rpx;
  --space-lg: 40rpx;
}
